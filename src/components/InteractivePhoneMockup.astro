            <div class="bg-[#F5F3EB] px-3.5 pt-1 pb-2 border-b border-ink/10 flex items-center justify-between">
              <!-- Left: Official Logo + Title + LVL pill + Subtitle -->
              <div class="flex items-center gap-2.5">
