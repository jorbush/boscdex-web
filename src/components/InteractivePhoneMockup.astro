---
import type { Locale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
---

<section id="preview" class="py-16 md:py-24 bg-[#FAF8F2] border-b-2.5 border-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-white border-2 border-ink rounded-full shadow-hard-sm mb-3">
        <span class="font-pixel text-xs font-bold text-forest">CAPTURA REAL DE L'APLICACIÓ</span>
      </div>
      <h2 class="font-pixel text-3xl sm:text-4xl lg:text-5xl font-bold text-ink tracking-tight">
        {t.interactivePreview.title}
      </h2>
      <p class="mt-3 text-base sm:text-lg text-ink-soft font-medium">
        {t.interactivePreview.subtitle}
      </p>

      <!-- Screen Selector Tabs (Matching the 3 real app sections) -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 mt-8" id="screen-tabs">
        <button
          type="button"
          data-tab="album"
          class="tab-btn active px-4 py-2 font-pixel text-xs sm:text-sm font-bold rounded-xl retro-btn bg-forest text-white shadow-arcade-btn"
        >
          {t.interactivePreview.tabs.album}
        </button>
        <button
          type="button"
          data-tab="scanner"
          class="tab-btn px-4 py-2 font-pixel text-xs sm:text-sm font-bold rounded-xl retro-btn bg-white text-ink shadow-arcade-btn hover:bg-parchment-light"
        >
          {t.interactivePreview.tabs.scanner}
        </button>
        <button
          type="button"
          data-tab="journal"
          class="tab-btn px-4 py-2 font-pixel text-xs sm:text-sm font-bold rounded-xl retro-btn bg-white text-ink shadow-arcade-btn hover:bg-parchment-light"
        >
          {t.interactivePreview.tabs.journal}
        </button>
        <button
          type="button"
          data-tab="safety"
          class="tab-btn px-4 py-2 font-pixel text-xs sm:text-sm font-bold rounded-xl retro-btn bg-white text-arcade-red shadow-arcade-btn hover:bg-parchment-light"
