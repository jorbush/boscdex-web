      <div class="w-full max-w-[395px] bg-[#1E2822] p-3 rounded-[46px] border-4 border-ink shadow-hard-lg">
        
        <!-- Phone Bezel / Screen Housing -->
        <div class="bg-[#F5F3EB] rounded-[38px] overflow-hidden border-2 border-ink flex flex-col h-[670px] relative">
          
          <!-- iOS Status Bar & Dynamic Island -->
