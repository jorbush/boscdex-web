---
import type { Locale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
---

<footer class="bg-[#1E2822] text-[#F5F3EB] pt-16 pb-12 border-t-4 border-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-ink-soft">
      
      <!-- Brand & Mascot Col -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-full border-2 border-forest overflow-hidden bg-white shrink-0">
            <img src="/assets/icons/boscdex_logo.png" alt="Boscdex" class="w-full h-full object-cover" />
          </div>
          <div>
            <span class="font-pixel text-2xl font-bold tracking-wider text-white block leading-none">
              BOSCDEX
            </span>
            <span class="text-[11px] font-pixel text-forest-light uppercase tracking-widest block mt-0.5">
              {t.hero.tagline}
            </span>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-[#D4E0CE] leading-relaxed max-w-sm font-medium">
          La primera eina de camp 100% offline pensada específicament per a la tradició boletaire i la riquesa biològica dels boscos de Catalunya.
        </p>

        <div class="flex items-center gap-2 pt-2">
          <a
            href="https://github.com/jorbush/boscdex"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 bg-[#FAF8F2] text-ink font-pixel text-xs font-bold rounded-lg border border-ink hover:bg-forest hover:text-white transition-colors"
          >
            ★ Star on GitHub
          </a>
          <a
            href="https://github.com/jorbush/boscdex/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 bg-forest text-white font-pixel text-xs font-bold rounded-lg border border-ink hover:bg-forest-pine transition-colors"
          >
            📦 Releases
          </a>
        </div>
      </div>

      <!-- Quick Nav Links -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="font-pixel text-sm font-bold text-white uppercase tracking-wider">
          Navegació
        </h4>
        <ul class="space-y-2 text-xs font-pixel text-[#D4E0CE]">
          <li><a href="#features" class="hover:text-white transition-colors">▸ {t.nav.features}</a></li>
          <li><a href="#species" class="hover:text-white transition-colors">▸ {t.nav.species}</a></li>
          <li><a href="#trees" class="hover:text-white transition-colors">▸ Arbres Indicadors</a></li>
          <li><a href="#safety" class="hover:text-arcade-red transition-colors text-arcade-red">▸ ⚠️ {t.nav.safety}</a></li>
          <li><a href="#ios-guide" class="hover:text-white transition-colors">▸ 🍏 {t.nav.iosGuide}</a></li>
          <li><a href="#docs" class="hover:text-white transition-colors">▸ {t.nav.docs}</a></li>
          <li><a href="#download" class="hover:text-white transition-colors">▸ {t.nav.download}</a></li>
        </ul>
      </div>

      <!-- Language & Open Source Links -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="font-pixel text-sm font-bold text-white uppercase tracking-wider">
          Idiomes / Languages
        </h4>
        <div class="flex gap-2">
          <a href="/" class={`px-2.5 py-1 text-xs font-pixel font-bold rounded border ${locale === 'ca' ? 'bg-forest text-white border-forest' : 'border-ink-soft text-[#D4E0CE] hover:text-white'}`}>Català</a>
          <a href="/es" class={`px-2.5 py-1 text-xs font-pixel font-bold rounded border ${locale === 'es' ? 'bg-forest text-white border-forest' : 'border-ink-soft text-[#D4E0CE] hover:text-white'}`}>Castellano</a>
          <a href="/en" class={`px-2.5 py-1 text-xs font-pixel font-bold rounded border ${locale === 'en' ? 'bg-forest text-white border-forest' : 'border-ink-soft text-[#D4E0CE] hover:text-white'}`}>English</a>
        </div>

        <div class="pt-3">
          <h4 class="font-pixel text-sm font-bold text-white uppercase tracking-wider mb-1.5">
            Comunitat & Codi
          </h4>
          <p class="text-xs text-[#D4E0CE] leading-relaxed">
            Desenvolupat amb Flutter, SQLite Drift i TFLite Edge ML.
            100% Codi Obert sota llicència de programari lliure.
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Legal Notice & Copyright -->
    <div class="pt-8 text-center space-y-3">
      <div class="p-4 bg-[#141C17] border border-ink-soft rounded-2xl max-w-4xl mx-auto">
        <p class="text-xs text-[#8A9C91] leading-relaxed font-sans">
          <strong class="text-arcade-red font-pixel">⚠️ {locale === 'ca' ? 'AVÍS LEGAL IMPORTANT' : locale === 'es' ? 'AVISO LEGAL IMPORTANTE' : 'IMPORTANT LEGAL DISCLAIMER'}:</strong> {t.footer.disclaimer}
        </p>
      </div>

      <p class="text-xs font-pixel text-[#8A9C91]">
        {t.footer.rights} • {t.footer.openSource}
      </p>
    </div>

  </div>
</footer>
