              <span class="w-2 h-2 rounded-full bg-[#1E2822]"></span>
            </div>

            <div class="flex items-center gap-1.5 text-ink text-xs font-bold">
              <span>●●●</span>
              <span>📶</span>
              <span>🔋</span>
            </div>
          </div>

          <!-- TAB 1: 🍄 BOSCDEX (1:1 with Screenshot 2) -->
