<script>
  function setupMockupTabs() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('#screen-tabs .tab-btn');
    const views = document.querySelectorAll<HTMLElement>('.screen-view');

    function setActiveTab(targetTab: string) {
      if ((window as any).playSfx) (window as any).playSfx('blip');

      tabButtons.forEach(btn => {
        const isMatch = btn.getAttribute('data-tab') === targetTab;
        if (isMatch) {
          btn.classList.add('bg-forest', 'text-white');
          btn.classList.remove('bg-white', 'text-ink', 'text-arcade-red');
        } else {
          btn.classList.remove('bg-forest', 'text-white');
          btn.classList.add('bg-white', 'text-ink');
        }
      });

      views.forEach(view => {
        const viewId = `view-${targetTab}`;
        if (view.id === viewId) {
          view.classList.remove('hidden');
        } else {
          view.classList.add('hidden');
        }
      });
    }

    (window as any).switchMockupTab = setActiveTab;

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        if (tab) setActiveTab(tab);
      });
    });
  }

  setupMockupTabs();
</script>
