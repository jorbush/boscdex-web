# Build outputs
dist/
.astro/

# Dependencies
node_modules/
.pnpm-store/

# Environment variables & secrets
.env
.env.*
!.env.example

# Large binary files & APKs (GitHub rejects files > 100MB; use GitHub Releases)
*.apk
public/downloads/*.apk
!public/downloads/.gitkeep

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# macOS / OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary directories and cache
.cache/
.temp/
tmp/
